# Copy to .env and fill in, then `export $(cat .env | xargs)` before running,
# or use a tool like python-dotenv / direnv.

# Optional: enables Claude-assisted link picking and page classification.
# Without this, the tool falls back to keyword-based heuristics only.
ANTHROPIC_API_KEY=

# Required to use the "Submit to Google Form" feature.
# Get these from the ScamBusters Discord: /username and /team
SCAMBUSTERS_USERNAME=
SCAMBUSTERS_TEAM_CODE=

# Optional: only needed if you plan to use the opt-in signup module.
SIGNUP_EMAIL_DOMAIN=
SIGNUP_PASSWORD=ResearchOnly!2026
