# Operation Hunter v2.0 — copy to .env (setup.bat does this) and adjust. Every setting is optional.

# Web server
PORT=3000
HOST=127.0.0.1

# Where the SQLite database, backups and caches live (default: ./data)
# HUNTER_DATA_DIR=./data

# live = query passive public sources (DNS, certificate logs, RDAP, RIPEstat, urlscan search, block explorers)
# offline = internal data, cache and the Main Platform only. Can also be switched in Settings.
# HUNTER_NETWORK_MODE=live
# HUNTER_DNS_SERVERS=1.1.1.1,8.8.8.8
# HUNTER_DAILY_LOOKUPS=4000   # v2.0: daily public-lookup allowance shared fairly across operations (pursuits + standing hunts)

# Optional API keys for higher rate limits (Settings can store these too)
# URLSCAN_API_KEY=
# TRONGRID_API_KEY=
# HACKERTARGET_API_KEY=

# Main Investigation Platform integration (Settings can store these too)
# MAIN_PLATFORM_URL=http://localhost:8787
# MAIN_PLATFORM_API_KEY=            # the operation_hunter entry in Main's MODULE_API_KEYS
# MAIN_SITES_TOKEN=                 # optional
# HUNTER_PUBLIC_URL=http://localhost:3000   # how Main links back to Hunter
# MAIN_PLATFORM_ENABLED=true

# Optional second-opinion analysis via Gemini (deterministic analysis is used without it)
# GEMINI_API_KEY=
# GEMINI_MODEL=
